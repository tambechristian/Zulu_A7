			(ref "BTN")
			(value "PTS810")
			(footprint "zulu_a7:PTS810")
			(description "Tactile switch, momentary, normally open. Package PTA-142 is assigned and drawn from the datasheet land; the note that said otherwise was left behind when it was.")
			(fields
				(field
					(name "GATENAME_1") "G$1")
				(field
