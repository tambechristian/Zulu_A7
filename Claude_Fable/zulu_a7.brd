<param name="mdWireWire" value="3mil"/>
<param name="mdWirePad" value="3mil"/>
<param name="mdWireVia" value="3mil"/>
<param name="mdPadPad" value="3mil"/>
<param name="mdPadVia" value="3mil"/>
<param name="mdViaVia" value="3mil"/>
<param name="mdSmdPad" value="3mil"/>
<param name="mdSmdVia" value="0mil"/>
<param name="mdSmdSmd" value="3mil"/>
<param name="mdCopperDimension" value="0.3mm"/>
<param name="mdDrill" value="0.1mm"/>
<param name="msWidth" value="3mil"/>
<param name="msDrill" value="0.1mm"/>
<param name="dpMaxLengthDifference" value="10mm"/>
<param name="dpGapFactor" value="2.5"/>
<description language="en">&lt;b&gt;Zulu A7 - 8-layer PCBWay build&lt;/b&gt;&lt;p&gt;Provisional symmetric 1.6mm stack for layout: L1 signal, L2 solid GND, L3 horizontal signal, L4 vertical signal, L5 VCC3V3 plane, L6 vertical signal, L7 horizontal signal, L8 bottom signal. Final dielectric, copper, and sequential-lamination stack require PCBWay pre-production approval. Final island routing uses 4x L1-L5, 2x L5-L16, 1x L1-L2, and 2x L6-L16 blind vias. U2 exposed-pad vias require IPC-4761 Type VII resin fill, copper cap and planarization; simple open or tented vias are not an approved substitute.</description>
<param name="layerSetup" value="((1+2+3+4+5))*6+7+(16)"/>
<param name="mtCopper" value="0.035mm 0.018mm 0.018mm 0.018mm 0.018mm 0.018mm 0.018mm 0.035mm 0.035mm 0.035mm 0.035mm 0.035mm 0.035mm 0.035mm 0.035mm 0.035mm"/>
<param name="mtIsolate" value="0.12mm 0.2mm 0.25mm 0.282mm 0.25mm 0.2mm 0.12mm 0.15mm 0.2mm 0.15mm 0.2mm 0.15mm 0.2mm 0.15mm 0.2mm"/>
<param name="mdViaViaSameLayer" value="3mil"/>
<param name="mnLayersViaInSmd" value="2"/>
<param name="mdSmdStop" value="0mil"/>
<param name="msMicroVia" value="0.1mm"/>
<param name="msBlindViaRatio" value="5"/>
<param name="rvPadTop" value="0.25"/>
<param name="rvPadInner" value="0.25"/>
<param name="rvPadBottom" value="0.25"/>
<param name="rvViaOuter" value="0.25"/>
<param name="rvViaInner" value="0.25"/>
<param name="rvMicroViaOuter" value="0.25"/>
<param name="rvMicroViaInner" value="0.25"/>
<param name="rlMinPadTop" value="0.1mm"/>
<param name="rlMaxPadTop" value="0.5mm"/>
<param name="rlMinPadInner" value="0.1mm"/>
<param name="rlMaxPadInner" value="0.5mm"/>
<param name="rlMinPadBottom" value="0.1mm"/>
<param name="rlMaxPadBottom" value="0.5mm"/>
<param name="rlMinViaOuter" value="0.05mm"/>
<param name="rlMaxViaOuter" value="0.5mm"/>
