		(comp
			(ref "R1")
			(value "4.7K")
			(footprint "zulu_a7:742C043")
			(description "Resistor 2-pack   Package of two resistors.")
			(fields
				(field
					(name "GATENAME_1") "A")
				(field
					(name "SYMBOLNAME_1") "R1NV0")
				(field
					(name "GATENAME_2") "B")
				(field
					(name "SYMBOLNAME_2") "R1NV0")
				(field
					(name "DEVICENAME") "742")
				(field
					(name "LIBRARYNAME") "ctambe")
				(field
					(name "DEVICESETNAME") "RES2")
				(field
					(name "MANF") "CTS")
				(field
					(name "MANF#") "742C043472JP")
				(field
					(name "SPEC") "2 x 4.7K +-5% isolated array, 0606 concave 1.60 x 1.60 mm, 0.80 mm pitch, 63 mW per element")
				(field
					(name "NOTE") "The two configuration pull-ups in one package: A on INIT_B (net FPGA-INIT#), B on PROGRAM_B (net RST#). Both commons are pads 3 and 4, side by side on one long side of the body, and both go to VCC3V3. CTS publishes ONE recommended land pattern for the whole 742 package family, so this footprint is the 742C083 pad cell already validated for R34 with two pads per side instead of four. 5 percent: the 742C043 has no 1 percent option either, and a configuration pull-up does not care; 63 mW per element against the 2.3 mW that 3.3 V across 4.7 k actually dissipates. Alternate on the identical land: Panasonic EXB-V4V472JV, same 1.60 x 1.60 mm concave body on 0.80 mm pitch. Do NOT substitute EXB-34V472JV -- same size, convex terminals, different land. R99, the third 4.7 k pull-up on this sheet, stays discrete: it sits on PROG#, the far side of the 100 ohm now in R4. TOLERANCE AGAINST UG470: Table 2-4 asks for a pull-up of 4.7 kohm OR LESS on both of these pins, and this is a 5 percent part, so its worst case is 4.935 k -- 5 percent outside the stated maximum. That is a wording problem rather than a physical one. The limit exists to hold the pin high against input leakage, and DS181 worst-case leakage of 15 uA across 4.935 k is 74 mV, against a VIH of 2.0 V. The discretes this replaces were 1 percent parts and were already outside the same limit, at 4.747 k. Strict compliance would mean 4.3 kohm +-5 percent (4.515 k worst case), but CTS does not stock a 432 code in the 742C043 family -- the stocked spread is 101, 220, 470, 471, 472, 473, 102, 103 and 104 -- so buying compliance here would cost availability, which is the thing that actually stops a board getting built. Dropping to the next stocked value, 1 k, would cost margin where it matters: it lifts the low level the bridge can assert on RST# through the 100 ohm from 0.10 V to 0.43 V.")
				(field
					(name "Footprint") "zulu_a7:742C043")
				(field
					(name "Datasheet")
				)
				(field
					(name "Description") "Resistor 2-pack   Package of two resistors.")
			)
			(libsource
				(lib "")
				(part "RES2742_1")
				(description "Resistor 2-pack   Package of two resistors.")
			)
			(property
				(name "GATENAME_1")
				(value "A")
			)
			(property
				(name "SYMBOLNAME_1")
				(value "R1NV0")
			)
			(property
				(name "GATENAME_2")
				(value "B")
			)
			(property
				(name "SYMBOLNAME_2")
				(value "R1NV0")
			)
			(property
				(name "DEVICENAME")
				(value "742")
			)
			(property
				(name "LIBRARYNAME")
				(value "ctambe")
			)
			(property
				(name "DEVICESETNAME")
				(value "RES2")
			)
			(property
				(name "MANF")
				(value "CTS")
			)
			(property
				(name "MANF#")
				(value "742C043472JP")
			)
			(property
				(name "SPEC")
				(value "2 x 4.7K +-5% isolated array, 0606 concave 1.60 x 1.60 mm, 0.80 mm pitch, 63 mW per element")
			)
			(property
				(name "NOTE")
				(value "The two configuration pull-ups in one package: A on INIT_B (net FPGA-INIT#), B on PROGRAM_B (net RST#). Both commons are pads 3 and 4, side by side on one long side of the body, and both go to VCC3V3. CTS publishes ONE recommended land pattern for the whole 742 package family, so this footprint is the 742C083 pad cell already validated for R34 with two pads per side instead of four. 5 percent: the 742C043 has no 1 percent option either, and a configuration pull-up does not care; 63 mW per element against the 2.3 mW that 3.3 V across 4.7 k actually dissipates. Alternate on the identical land: Panasonic EXB-V4V472JV, same 1.60 x 1.60 mm concave body on 0.80 mm pitch. Do NOT substitute EXB-34V472JV -- same size, convex terminals, different land. R99, the third 4.7 k pull-up on this sheet, stays discrete: it sits on PROG#, the far side of the 100 ohm now in R4. TOLERANCE AGAINST UG470: Table 2-4 asks for a pull-up of 4.7 kohm OR LESS on both of these pins, and this is a 5 percent part, so its worst case is 4.935 k -- 5 percent outside the stated maximum. That is a wording problem rather than a physical one. The limit exists to hold the pin high against input leakage, and DS181 worst-case leakage of 15 uA across 4.935 k is 74 mV, against a VIH of 2.0 V. The discretes this replaces were 1 percent parts and were already outside the same limit, at 4.747 k. Strict compliance would mean 4.3 kohm +-5 percent (4.515 k worst case), but CTS does not stock a 432 code in the 742C043 family -- the stocked spread is 101, 220, 470, 471, 472, 473, 102, 103 and 104 -- so buying compliance here would cost availability, which is the thing that actually stops a board getting built. Dropping to the next stocked value, 1 k, would cost margin where it matters: it lifts the low level the bridge can assert on RST# through the 100 ohm from 0.10 V to 0.43 V.")
			)
