{ FabBCopper_Rev2Fix.pas -- generated by tools/emit_copper.py from tools/route/rev2/delta_r96.json, THEN EDITED BY HAND
  (2026-11-11): the block that finds the title 'ZULU A7 2.0' and moves it 0.2 mm east (silk clearance to the moved
  '30 C20' label) is not in the JSON; regenerating from delta_r96.json alone would drop the title move.
  0 vias, 4 tracks on 2 nets. Run PlaceRev2Fix with Zulu_a7_no_pmod.PcbDoc focused, then save. }

Var
    Brd : IPCB_Board;

Function NetByName(AName : String) : IPCB_Net;
Var
    It : IPCB_BoardIterator;
    N  : IPCB_Net;
Begin
    Result := Nil;
    It := Brd.BoardIterator_Create;
    It.AddFilter_ObjectSet(MkSet(eNetObject));
    It.AddFilter_LayerSet(AllLayers);
    It.AddFilter_Method(eProcessAll);
    N := It.FirstPCBObject;
    While N <> Nil Do
    Begin
        If N.Name = AName Then Result := N;
        N := It.NextPCBObject;
    End;
    Brd.BoardIterator_Destroy(It);
End;

Procedure V(N : IPCB_Net; X, Y, S, H : Double; Lo, Hi : TLayer);
Var
    O : IPCB_Via;
Begin
    O := PCBServer.PCBObjectFactory(eViaObject, eNoDimension, eCreate_Default);
    O.X := Brd.XOrigin + MMsToCoord(X); O.Y := Brd.YOrigin + MMsToCoord(Y);
    O.Size := MMsToCoord(S); O.HoleSize := MMsToCoord(H);
    O.LowLayer := Lo; O.HighLayer := Hi;
    O.Net := N; Brd.AddPCBObject(O); N.AddPCBObject(O);
End;

Procedure T(N : IPCB_Net; L : TLayer; W, X1, Y1, X2, Y2 : Double);
Var
    O : IPCB_Track;
Begin
    O := PCBServer.PCBObjectFactory(eTrackObject, eNoDimension, eCreate_Default);
    O.X1 := Brd.XOrigin + MMsToCoord(X1); O.Y1 := Brd.YOrigin + MMsToCoord(Y1);
    O.X2 := Brd.XOrigin + MMsToCoord(X2); O.Y2 := Brd.YOrigin + MMsToCoord(Y2);
    O.Layer := L; O.Width := MMsToCoord(W); O.Net := N; Brd.AddPCBObject(O);
End;

Procedure PlaceRev2Fix;
Var
    Doc : IDocument;
    N : IPCB_Net;
    It : IPCB_BoardIterator;
    O : IPCB_Via;
    Missing : String;
    Kill : TInterfaceList;
    K : IPCB_Track;
    i : Integer;
    nm : String;
    x, y, x2, y2, tw : Double;
    Cm : IPCB_Component;
    Tt, TtHit : IPCB_Text;
    nT : Integer;
    tx, ty : Double;
Begin
    Doc := GetWorkspace.DM_FocusedDocument;
    If (Doc = Nil) Or (Pos('\Zulu_A7_no_pmod\Rev_2\Imported zulu_a7.PrjPcb\Zulu_a7_no_pmod.PcbDoc', Doc.DM_FullPath) = 0) Then
    Begin
        ShowMessage('Refusing: focus Zulu_A7_no_pmod\Rev_2\Imported zulu_a7.PrjPcb\Zulu_a7_no_pmod.PcbDoc first.');
        Exit;
    End;
    Brd := PCBServer.GetCurrentPCBBoard;
    It := Brd.BoardIterator_Create;
    It.AddFilter_ObjectSet(MkSet(eViaObject));
    It.AddFilter_LayerSet(AllLayers);
    It.AddFilter_Method(eProcessAll);
    O := It.FirstPCBObject;
    While O <> Nil Do
    Begin
        If (Abs(O.X - Brd.XOrigin - MMsToCoord(-1000.0000)) < 300) And (Abs(O.Y - Brd.YOrigin - MMsToCoord(-1000.0000)) < 300) Then
        Begin
            Brd.BoardIterator_Destroy(It);
            ShowMessage('Refusing: this plan''s first via is already on the board.');
            Exit;
        End;
        O := It.NextPCBObject;
    End;
    Brd.BoardIterator_Destroy(It);
    Missing := '';
    { title 'ZULU A7 2.0' moves 0.2 mm east (silk clearance to the moved '30 C20' label); exactly one must match }
    nT := 0; TtHit := Nil;
    It := Brd.BoardIterator_Create;
    It.AddFilter_ObjectSet(MkSet(eTextObject));
    It.AddFilter_LayerSet(MkSet(eTopOverlay));
    It.AddFilter_Method(eProcessAll);
    Tt := It.FirstPCBObject;
    While Tt <> Nil Do
    Begin
        tx := CoordToMMs(Tt.BoundingRectangle.Left - Brd.XOrigin); ty := CoordToMMs(Tt.BoundingRectangle.Bottom - Brd.YOrigin);
        If (Tt.Text = 'ZULU A7 2.0') And (tx > 37.0) And (tx < 38.2) And (ty > 4.4) And (ty < 5.6) Then Begin TtHit := Tt; nT := nT + 1; End;
        Tt := It.NextPCBObject;
    End;
    Brd.BoardIterator_Destroy(It);
    If nT <> 1 Then Begin ShowMessage('Refusing: title ZULU A7 2.0 found ' + IntToStr(nT) + ' times near (37.5, 5.0); nothing changed.'); Exit; End;

    Cm := Brd.GetPcbComponentByRefDes('R96');
    If (Cm = Nil) Or (Abs(CoordToMMs(Cm.Y - Brd.YOrigin) - 19.9500) > 0.002) Or (Abs(CoordToMMs(Cm.X - Brd.XOrigin) - 19.3498) > 0.002) Then
    Begin
        ShowMessage('Refusing: R96 is missing or not at (19.3498, 19.9500); nothing changed.');
        Exit;
    End;
    Kill := TInterfaceList.Create;
    It := Brd.BoardIterator_Create;
    It.AddFilter_ObjectSet(MkSet(eTrackObject));
    It.AddFilter_LayerSet(AllLayers);
    It.AddFilter_Method(eProcessAll);
    K := It.FirstPCBObject;
    While K <> Nil Do
    Begin
        nm := ''; If K.Net <> Nil Then nm := K.Net.Name;
        x := CoordToMMs(K.X1 - Brd.XOrigin); y := CoordToMMs(K.Y1 - Brd.YOrigin);
        x2 := CoordToMMs(K.X2 - Brd.XOrigin); y2 := CoordToMMs(K.Y2 - Brd.YOrigin);
        tw := CoordToMMs(K.Width);
        If (nm = 'VCC3V3') And (K.Layer = eBottomLayer) And (Abs(tw - 0.2000) < 0.002) And (((Abs(x - 18.1499) < 0.002) And (Abs(y - 19.3500) < 0.002) And (Abs(x2 - 18.6998) < 0.002) And (Abs(y2 - 19.8821) < 0.002)) Or ((Abs(x - 18.6998) < 0.002) And (Abs(y - 19.8821) < 0.002) And (Abs(x2 - 18.1499) < 0.002) And (Abs(y2 - 19.3500) < 0.002))) Then Kill.Add(K);
        If (nm = 'EE-CLK') And (K.Layer = eBottomLayer) And (Abs(tw - 0.0762) < 0.002) And (((Abs(x - 19.4250) < 0.002) And (Abs(y - 20.2500) < 0.002) And (Abs(x2 - 19.2750) < 0.002) And (Abs(y2 - 20.1000) < 0.002)) Or ((Abs(x - 19.2750) < 0.002) And (Abs(y - 20.1000) < 0.002) And (Abs(x2 - 19.4250) < 0.002) And (Abs(y2 - 20.2500) < 0.002))) Then Kill.Add(K);
        If (nm = 'EE-CLK') And (K.Layer = eBottomLayer) And (Abs(tw - 0.0762) < 0.002) And (((Abs(x - 19.2750) < 0.002) And (Abs(y - 20.1000) < 0.002) And (Abs(x2 - 19.1500) < 0.002) And (Abs(y2 - 20.0500) < 0.002)) Or ((Abs(x - 19.1500) < 0.002) And (Abs(y - 20.0500) < 0.002) And (Abs(x2 - 19.2750) < 0.002) And (Abs(y2 - 20.1000) < 0.002))) Then Kill.Add(K);
        If (nm = 'EE-CLK') And (K.Layer = eBottomLayer) And (Abs(tw - 0.0762) < 0.002) And (((Abs(x - 19.8750) < 0.002) And (Abs(y - 20.2500) < 0.002) And (Abs(x2 - 19.4250) < 0.002) And (Abs(y2 - 20.2500) < 0.002)) Or ((Abs(x - 19.4250) < 0.002) And (Abs(y - 20.2500) < 0.002) And (Abs(x2 - 19.8750) < 0.002) And (Abs(y2 - 20.2500) < 0.002))) Then Kill.Add(K);
        K := It.NextPCBObject;
    End;
    Brd.BoardIterator_Destroy(It);
    If Kill.Count <> 4 Then
    Begin
        ShowMessage('Refusing: found ' + IntToStr(Kill.Count) + ' of the 4 tracks to remove; nothing changed.');
        Kill.Free;
        Exit;
    End;
    For i := 0 To Kill.Count - 1 Do Brd.RemovePCBObject(Kill.Items[i]);
    Kill.Free;
    Cm := Brd.GetPcbComponentByRefDes('R96');
    Cm.BeginModify;
    Cm.X := Cm.X + MMsToCoord(-0.0600);
    Cm.Y := Cm.Y + MMsToCoord(0.0000);
    Cm.EndModify;
    N := NetByName('EE-CLK');
    If N = Nil Then Missing := Missing + ' EE-CLK' Else
    Begin
        T(N, eBottomLayer, 0.0762, 19.3650, 20.2500, 19.2150, 20.1000);
        T(N, eBottomLayer, 0.0762, 19.2150, 20.1000, 19.0900, 20.0500);
        T(N, eBottomLayer, 0.0762, 19.8750, 20.2500, 19.3650, 20.2500);
    End;
    N := NetByName('VCC3V3');
    If N = Nil Then Missing := Missing + ' VCC3V3' Else
    Begin
        T(N, eBottomLayer, 0.2000, 18.1499, 19.3500, 18.6000, 19.7750);
    End;
    TtHit.BeginModify; TtHit.MoveByXY(MMsToCoord(0.2), 0); TtHit.EndModify;
    Brd.ViewManager_FullUpdate;
    ShowMessage('Title moved 0.2 mm east. Moved 1 parts, removed 4 tracks and 0 vias, placed 0 vias and 4 tracks. Missing nets:' + Missing + '. Save, then mark microvias.');
End;
