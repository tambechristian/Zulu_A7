		(comp
			(ref "J1")
			(value "Pmod 2x6")
			(footprint "zulu_a7:2X06")
			(description "PIN HEADER 2x6 (Pmod)   Digilent peripheral-module connector. Pins 1-4 and 7-10 are signals, 5 and 11 are GND, 6 and 12 are VCC -- eight signals, not twelve.")
			(fields
				(field
					(name "GATENAME_1") "G$1")
				(field
					(name "SYMBOLNAME_1") "PINH2X6")
				(field
					(name "DEVICENAME")
				)
				(field
					(name "LIBRARYNAME") "ctambe")
				(field
					(name "DEVICESETNAME") "PINHD-2X6")
				(field
					(name "MANF") "Sullins")
				(field
					(name "MANF#") "PPTC062LFBN-RC")
				(field
					(name "NOTE") "A SOCKET, NOT PINS, AND THE LIBRARY NAME DISAGREES WITH THAT. The package is called PIN HEADER 2x6 and the deviceset PINHD-2X6, which is inherited naming, but on a Digilent Pmod the HOST carries the female socket and the peripheral module carries the male pins that plug into it. Cmod A7 is the same. Order male pins off that library name and no Pmod will mate. The footprint is 12 plated holes on 2.54 either way, so a male header such as Sullins PRPC006DAAN-RC drops into the same land if you would rather have pins and a cable. Height 8.5 mm is not a problem: J1 is on the FRONT, and it is the back that faces a breadboard a couple of millimetres away.")
				(field
					(name "SPEC") "2x6 female header, 2.54 mm pitch, through-hole, 12 way -- Pmod host socket")
				(field
					(name "Footprint") "zulu_a7:2X06")
				(field
					(name "Datasheet")
				)
				(field
					(name "Description") "PIN HEADER 2x6 (Pmod)   Digilent peripheral-module connector. Pins 1-4 and 7-10 are signals, 5 and 11 are GND, 6 and 12 are VCC -- eight signals, not twelve.")
			)
			(libsource
				(lib "ctambe")
				(part "PINHD-2X6")
				(description "PIN HEADER 2x6 (Pmod)   Digilent peripheral-module connector. Pins 1-4 and 7-10 are signals, 5 and 11 are GND, 6 and 12 are VCC -- eight signals, not twelve.")
			)
