		(comp
			(ref "JP3")
			(value "JTAG TCK/TMS/GND")
			(footprint "zulu_a7:1X03-NOSILK")
			(description "Three plated holes, 1x3 on 2.54 mm   NOT a fitted header, which is why it is no longer called one. The footprint is an ordinary 1x3 header pattern and a strip could be soldered in for bring-up, but nothing is populated: a 1x3 body clears the Pmod shroud beside it by 0.09 mm, inside anyone's assembly tolerance. Drawn dashed with open holes so the sheet stops reading as a connector, the way the 2x3 it replaced did.")
			(fields
				(field
					(name "GATENAME_1") "A")
				(field
					(name "SYMBOLNAME_1") "TP1X3")
				(field
					(name "DEVICENAME") "NOSILK")
				(field
					(name "LIBRARYNAME") "pinhead")
				(field
					(name "DEVICESETNAME") "TESTPT-1X3")
				(field
					(name "NOTE") "Bare plated holes -- NO HEADER FITTED, nothing to order. Three of the six JTAG holes; JP4 carries the other three, 17.96 mm away on the far side of the Pmod. Each row has 3.05 mm of board to the Pmod but only 0.09 mm to a 1x3 strip's body, so these are for flying leads or a pogo jig. The FT2232 does JTAG over USB on channel B; this is the fallback.")
				(field
					(name "DNS") "Yes")
				(field
					(name "SPEC") "DNS - do not stuff: three bare plated holes, 1x3 on 2.54 mm, for flying leads or pogo pins; no part to order (flagged 2026-09-08)")
				(field
					(name "Footprint") "zulu_a7:1X03-NOSILK")
				(field
					(name "Datasheet")
				)
				(field
					(name "Description") "Three plated holes, 1x3 on 2.54 mm   NOT a fitted header, which is why it is no longer called one. The footprint is an ordinary 1x3 header pattern and a strip could be soldered in for bring-up, but nothing is populated: a 1x3 body clears the Pmod shroud beside it by 0.09 mm, inside anyone's assembly tolerance. Drawn dashed with open holes so the sheet stops reading as a connector, the way the 2x3 it replaced did.")
			)
