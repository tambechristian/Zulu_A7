    If Bot Then B.BodyProjection := eBoardSide_Bottom Else B.BodyProjection := eBoardSide_Top;
    Md := B.ModelFactory_CreateExtruded(0, MMsToCoord(H), $808080);
    B.SetModel(Md);
    Cm.AddPCBObject(B);
    Brd.AddPCBObject(B);
End;

