{ FabBSilkSwap22.pas -- 2026-11-24, fabb: X2 pin labels -- each name takes its pin number's place and the numbers go;
  the board title moves down 1.23 mm; the printed U1 label moves under the FPGA and a U4 label is printed right of U4.
  Generated by emit_silk_pas.py from final_fabb.json: 36 texts changed, 28 deleted, U1 designator hidden.
  The U1 / U4 labels are free texts (reused pin numbers 23 / 24): a designator XLocation write does not stick here.
  Every text is found by its exact text and position (board mm from the origin) BEFORE anything changes;
  it refuses unless each is found exactly once. Save, DRC, then save again after the clean DRC. }
Function FindFree(B : IPCB_Board; S : String; X, Y : Double) : IPCB_Text;
Var
    It : IPCB_BoardIterator;
    T  : IPCB_Text;
    n  : Integer;
Begin
    Result := Nil;
    n := 0;
    It := B.BoardIterator_Create;
    It.AddFilter_ObjectSet(MkSet(eTextObject));
    It.AddFilter_LayerSet(MkSet(eTopOverlay));
    It.AddFilter_Method(eProcessAll);
    T := It.FirstPCBObject;
    While T <> Nil Do
    Begin
        If (Not T.InComponent) And (T.Text = S) Then
            If (Abs(CoordToMMs(T.XLocation - B.XOrigin) - X) < 0.002) And (Abs(CoordToMMs(T.YLocation - B.YOrigin) - Y) < 0.002) Then
            Begin
                Result := T;
                n := n + 1;
            End;
        T := It.NextPCBObject;
    End;
    B.BoardIterator_Destroy(It);
    If n <> 1 Then Result := Nil;
End;

