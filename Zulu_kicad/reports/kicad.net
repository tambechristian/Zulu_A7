		(comp
			(ref "U10")
			(value "93LC46BT-I/SN")
			(footprint "zulu_a7:SPI-8_SOIC_150")
			(description "Microchip 93LC46BT-I/SN, FTDI EEPROM (USB VID/PID/descriptors)   64 x 16 = 1 Kbit. DS_FT2232H p27: \"The EEPROM should be a 16 bit wide configuration such as a Microchip 93LC46B or equivalent capable of a 1 Mbit/s clock rate at VCC = +3.00 V to 3.6 V.\" The B suffix is the fixed x16 organisation, so pins 6 and 7 are both no-connect; only the selectable C variant puts ORG on pin 6.")
