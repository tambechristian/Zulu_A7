			(value "4.7K")
			(footprint "zulu_a7:742C083")
			(description "Resistor 4-pack   Package of four resistors.")
			(fields
				(field
					(name "GATENAME_1") "A")
				(field
					(name "SYMBOLNAME_1") "R1NV0")
