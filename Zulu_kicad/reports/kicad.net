				(field
					(name "MANF") "Lite-On")
				(field
					(name "MANF#") "LTST-C191KGKT")
				(field
					(name "NOTE") "Power-good indicator: VCC3V3 to LD5 to R78 680R to Q2 drain to GND. SELECTED FROM THE CIRCUIT, not recovered -- the part carried no value and no number. THE RESISTOR ALREADY CHOSE THE COLOUR: 680R off 3.3 V passes (3.3 - Vf)/680, which is 1.9 mA for a green LED or 2.1 for a red, but only 0.6 mA for a blue or white one, too dim to read. So it is a green or red part, and green is the convention for power good. 1.9 mA is low but plain on a modern high-efficiency 0603; take R78 to 330R if you want it brighter.")
				(field
					(name "SPEC") "green indicator, 0603, Vf 2.1V max at 2mA")
				(field
					(name "Footprint") "zulu_a7:LED0603")
				(field
					(name "Datasheet")
				)
