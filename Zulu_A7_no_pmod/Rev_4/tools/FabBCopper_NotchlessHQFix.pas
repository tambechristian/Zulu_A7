Function NetByName(AName : String) : IPCB_Net;
Var
    It : IPCB_BoardIterator;
    N  : IPCB_Net;
Begin
    Result := Nil;
    It := Brd.BoardIterator_Create;
    It.AddFilter_ObjectSet(MkSet(eNetObject));
    It.AddFilter_LayerSet(AllLayers);
    It.AddFilter_Method(eProcessAll);
    N := It.FirstPCBObject;
    While N <> Nil Do
    Begin
        If N.Name = AName Then Result := N;
        N := It.NextPCBObject;
    End;
    Brd.BoardIterator_Destroy(It);
End;

Function LN(Ly : TLayer) : String;
Begin
    Result := '?';
    If Ly = eTopLayer Then Result := 'T'
    Else If Ly = eMidLayer3 Then Result := '2'
    Else If Ly = eMidLayer1 Then Result := '3'
    Else If Ly = eMidLayer2 Then Result := '4'
    Else If Ly = eMidLayer4 Then Result := '5'
    Else If Ly = eBottomLayer Then Result := 'B';
End;

Function UM(Cv : TCoord) : Integer;
Begin
    Result := Round(CoordToMMs(Cv) * 10000);
End;

Function TrackKey(K : IPCB_Track) : String;
Var
    nm : String;
    a, b, c, d, tmp : Integer;
Begin
    nm := '';
    If K.Net <> Nil Then nm := K.Net.Name;
    a := UM(K.X1 - Brd.XOrigin); b := UM(K.Y1 - Brd.YOrigin);
    c := UM(K.X2 - Brd.XOrigin); d := UM(K.Y2 - Brd.YOrigin);
    If (a > c) Or ((a = c) And (b > d)) Then
    Begin
        tmp := a; a := c; c := tmp;
        tmp := b; b := d; d := tmp;
    End;
    Result := nm + '|' + LN(K.Layer) + '|' + IntToStr(UM(K.Width)) + '|' + IntToStr(a) + '|' + IntToStr(b) + '|' + IntToStr(c) + '|' + IntToStr(d);
End;

Function ViaKey(K : IPCB_Via) : String;
Var
    nm : String;
Begin
    nm := '';
    If K.Net <> Nil Then nm := K.Net.Name;
    Result := nm + '|' + IntToStr(UM(K.X - Brd.XOrigin)) + '|' + IntToStr(UM(K.Y - Brd.YOrigin)) + '|' + IntToStr(UM(K.HoleSize)) + '|' + IntToStr(UM(K.Size)) + '|' + LN(K.LowLayer) + '|' + LN(K.HighLayer);
End;

