		(comp
			(ref "LD1")
			(value "red")
			(footprint "zulu_a7:LED0603")
			(description "LED")
			(fields
				(field
					(name "GATENAME_1") "G$1")
				(field
					(name "SYMBOLNAME_1") "LED")
				(field
