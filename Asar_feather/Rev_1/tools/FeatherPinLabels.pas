    AddLabel('RS', 3.7650, 0.4150, 0, 0.800, 0.150);
    AddLabel('BTN', 42.2500, 6.9950, 0, 0.800, 0.150);
    AddLabel('A7', 41.1000, 8.2500, 0, 1.200, 0.200);
    AddLabel('ASAR', 39.9000, 9.9500, 0, 1.200, 0.200);
    Log.SaveToFile('C:\Users\tambe\Documents\Electronics\Zulu_A7\Asar_feather\docs\labels.log');
    Brd.ViewManager_FullUpdate;
