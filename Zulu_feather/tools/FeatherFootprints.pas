Procedure FeatherFpCanary;
Var
    Lib : IPCB_Library;
Begin
    Lib := FeatherLibOrNil;
    If Lib = Nil Then Exit;
    Draw_TP_1X03_SMD(Lib);
    Lib.Board.ViewManager_FullUpdate;
    ShowMessage('Canary drew TP-1X03-SMD. Check it, then run BuildFeatherFootprints.');
End;

Procedure BuildFeatherFootprints;
Var
    Lib : IPCB_Library;
Begin
    Lib := FeatherLibOrNil;
    If Lib = Nil Then Exit;
    Draw_QFN_64_9X9_P0_5_EP4_35(Lib);
    Draw_FBGA_54_8X8_P0_8(Lib);
    Draw_WSON_8_6X5_P1_27(Lib);
    Draw_USB_C_HRO_TYPE_C_31_M_12(Lib);
    Draw_FEATHER_28(Lib);
    Lib.Board.ViewManager_FullUpdate;
    ShowMessage('Drew 5 footprints. Save zulu_feather.PcbLib.');
End;
