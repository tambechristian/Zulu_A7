		(property "MANF#" "2x PRPC009SAAN-RC + 2x PRPC011SAAN-RC"
			(at 0 0 0)
			(layer "F.SilkS")
			(hide yes)
			(uuid "c763cbb0-57e4-4244-be1c-1ea4a00c8c37")
			(effects
				(font
