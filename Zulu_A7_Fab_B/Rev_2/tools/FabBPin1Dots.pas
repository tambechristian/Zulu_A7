  AddPin1Dots: one silkscreen dot per polarized part (pin 1 / A1; LED cathode), owned by the part.
  RemovePin1Dots: takes them off again (only arcs of exactly the planned size at the planned spots).
  Run with Zulu_A7_Fab_B\Rev_2\Imported zulu_a7.PrjPcb\zulu_a7_fab_b.PcbDoc focused, then DRC and File > Save. }

Var
    Brd : IPCB_Board;

Function FindPad(Cm : IPCB_Component; AName : String) : IPCB_Pad;
Var GI : IPCB_GroupIterator; O : IPCB_Primitive;
Begin
    Result := Nil;
    GI := Cm.GroupIterator_Create;
    GI.AddFilter_ObjectSet(MkSet(ePadObject));
    O := GI.FirstPCBObject;
    While O <> Nil Do
    Begin
        If O.Name = AName Then Result := O;
        O := GI.NextPCBObject;
    End;
    Cm.GroupIterator_Destroy(GI);
End;

Function DotAt(Cm : IPCB_Component; ALayer : TLayer; X, Y, R, W : Double) : IPCB_Arc;
Var GI : IPCB_GroupIterator; O : IPCB_Primitive;
Begin
    Result := Nil;
    GI := Cm.GroupIterator_Create;
    GI.AddFilter_ObjectSet(MkSet(eArcObject));
    O := GI.FirstPCBObject;
    While O <> Nil Do
    Begin
        If (O.Layer = ALayer) And (Abs(CoordToMMs(O.XCenter - Brd.XOrigin) - X) < 0.05) And
           (Abs(CoordToMMs(O.YCenter - Brd.YOrigin) - Y) < 0.05) Then Result := O;
        O := GI.NextPCBObject;
    End;
    Cm.GroupIterator_Destroy(GI);
End;

Function Ready(Doc : IDocument) : Boolean;
Begin
    Result := False;
    If (Doc = Nil) Or (Pos('\Zulu_A7_Fab_B\Rev_2\Imported zulu_a7.PrjPcb\zulu_a7_fab_b.PcbDoc', Doc.DM_FullPath) = 0) Then
    Begin
        ShowMessage('Refusing: focus Zulu_A7_Fab_B\Rev_2\Imported zulu_a7.PrjPcb\zulu_a7_fab_b.PcbDoc first.');
        Exit;
    End;
    Brd := PCBServer.GetCurrentPCBBoard;
    Result := Brd <> Nil;
End;

Function CheckPart(ARef, APad : String; ATop : Boolean; PX, PY : Double; Var Msg : String) : IPCB_Component;
Var Cm : IPCB_Component; P : IPCB_Pad;
Begin
    Result := Nil;
    Cm := Brd.GetPcbComponentByRefDes(ARef);
    If Cm = Nil Then Begin Msg := ARef + ' not found'; Exit; End;
    If ATop And (Cm.Layer <> eTopLayer) Then Begin Msg := ARef + ' is not on Top'; Exit; End;
    If (Not ATop) And (Cm.Layer <> eBottomLayer) Then Begin Msg := ARef + ' is not on Bottom'; Exit; End;
    P := FindPad(Cm, APad);
    If P = Nil Then Begin Msg := ARef + ' has no pad ' + APad; Exit; End;
    If (Abs(CoordToMMs(P.X - Brd.XOrigin) - PX) > 0.002) Or (Abs(CoordToMMs(P.Y - Brd.YOrigin) - PY) > 0.002) Then
    Begin Msg := ARef + '-' + APad + ' is not where the plan measured it'; Exit; End;
    Result := Cm;
End;

