<deviceset name="SDRAM-X16" prefix="U" uservalue="yes">
<description>&lt;b&gt;SDR SDRAM, x16, 54-pin TSOP-II&lt;/b&gt;&lt;p&gt;The 54-pin TSOP-II x16 SDR pinout is identical for 256Mb and 512Mb: both use row A0-A12 with banks BA0/BA1, and pin 40 is NC on both. They differ only in the column address width -- A0-A8 (512 columns) at 256Mb, A0-A9 (1024 columns) at 512Mb -- which is a memory-controller setting, not a wiring change.</description>
<gates>
<gate name="PART_VALUE" symbol="PART_VALUE-SDRAM-X16" x="0" y="7.62" addlevel="always"/>
<gate name="VDD@3" symbol="PL-SDRAM-X16" x="0" y="0" addlevel="must"/>
<gate name="DQ0" symbol="PL-SDRAM-X16" x="0" y="-2.54" addlevel="must" swaplevel="3"/>
