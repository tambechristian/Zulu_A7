	(text "2026-09-10: BTN pads 1-2 are one switch terminal and 3-4 the other. They were one pin each (\"1,2\" and \"3,4\"), an EAGLE multi-pad import artefact that matches no Altium footprint pad; now four pins, each pad on its partner's net."
		(exclude_from_sim no)
		(at 157.48 95.758 0)
		(effects
			(font
				(size 0.889 0.889)
			)
			(justify left bottom)
		)
		(uuid "bb1e23a6-6dfa-4b0a-8c29-77fe76045168")
	)
