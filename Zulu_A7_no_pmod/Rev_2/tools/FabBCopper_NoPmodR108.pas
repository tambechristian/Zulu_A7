Function NetByName(AName : String) : IPCB_Net;
Var
    It : IPCB_BoardIterator;
    N  : IPCB_Net;
Begin
    Result := Nil;
    It := Brd.BoardIterator_Create;
    It.AddFilter_ObjectSet(MkSet(eNetObject));
    It.AddFilter_LayerSet(AllLayers);
    It.AddFilter_Method(eProcessAll);
    N := It.FirstPCBObject;
    While N <> Nil Do
    Begin
        If N.Name = AName Then Result := N;
        N := It.NextPCBObject;
    End;
    Brd.BoardIterator_Destroy(It);
End;

Procedure V(N : IPCB_Net; X, Y, S, H : Double; Lo, Hi : TLayer);
Var
    O : IPCB_Via;
Begin
    O := PCBServer.PCBObjectFactory(eViaObject, eNoDimension, eCreate_Default);
    O.X := Brd.XOrigin + MMsToCoord(X); O.Y := Brd.YOrigin + MMsToCoord(Y);
    O.Size := MMsToCoord(S); O.HoleSize := MMsToCoord(H);
    O.LowLayer := Lo; O.HighLayer := Hi;
    O.Net := N; Brd.AddPCBObject(O); N.AddPCBObject(O);
End;

Procedure T(N : IPCB_Net; L : TLayer; W, X1, Y1, X2, Y2 : Double);
Var
    O : IPCB_Track;
Begin
    O := PCBServer.PCBObjectFactory(eTrackObject, eNoDimension, eCreate_Default);
    O.X1 := Brd.XOrigin + MMsToCoord(X1); O.Y1 := Brd.YOrigin + MMsToCoord(Y1);
    O.X2 := Brd.XOrigin + MMsToCoord(X2); O.Y2 := Brd.YOrigin + MMsToCoord(Y2);
    O.Layer := L; O.Width := MMsToCoord(W); O.Net := N; Brd.AddPCBObject(O);
End;

